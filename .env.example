# Minecraft Server Configuration
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.20.4
MC_AUTH=microsoft
MC_RECONNECT=true
MC_RECONNECT_DELAY=5000
MC_RECONNECT_MAX_RETRIES=10

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_CONTEXT_TOKENS=8000

# Web Dashboard
WEB_PORT=3001
DASHBOARD_PASSWORD=
BIND_LOCALHOST=false

# HTTPS (optional — provide paths to TLS cert/key files)
HTTPS_KEY=
HTTPS_CERT=

# Security
ENCRYPTION_KEY=your-32-char-hex-encryption-key-here
LEASH_MAX_DISTANCE=256
LEASH_ENABLED=true

# Token Cache
TOKEN_CACHE_DIR=./auth_cache

# Logging
LOG_LEVEL=info
LOG_FILE=
