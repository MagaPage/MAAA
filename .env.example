# Minecraft Server Configuration
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.20.4
MC_AUTH=microsoft

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Web Dashboard
WEB_PORT=3001

# Security
ENCRYPTION_KEY=your-32-char-hex-encryption-key-here
LEASH_MAX_DISTANCE=256
LEASH_ENABLED=true

# Token Cache
TOKEN_CACHE_DIR=./auth_cache

# Logging
LOG_LEVEL=info
